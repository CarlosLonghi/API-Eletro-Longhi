# Copie este arquivo para .env e ajuste os valores.
# .env nunca deve ser commitado (já está no .gitignore).

# Banco de dados (usado pelo docker-compose.yml e pelo application.properties)
DB_NAME=eletrolonghi
DB_USERNAME=postgres
DB_PASSWORD=postgres

# JWT - chave usada para assinar/validar os tokens de acesso. Gere um valor
# forte e aleatório em produção (ex.: openssl rand -base64 48).
JWT_SECRET=dev-only-secret-change-me

# Admin bootstrap - conta ADMIN criada automaticamente na primeira execução
ADMIN_NAME=admin
ADMIN_EMAIL=admin@eletrolonghi.com
ADMIN_PASSWORD=admin@123
