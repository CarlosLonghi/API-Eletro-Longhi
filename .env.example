# Copie este arquivo para .env e ajuste os valores.
# .env nunca deve ser commitado (já está no .gitignore).

# Banco de dados (usado pelo docker-compose.yml e pelo application.properties)
DB_NAME=eletrolonghi
DB_USERNAME=postgres
DB_PASSWORD=postgres

# JWT - chave usada para assinar/validar os tokens de acesso. Gere um valor
# forte e aleatório em produção (ex.: openssl rand -base64 48).
JWT_SECRET=dev-only-secret-change-me

# Admin bootstrap - conta ADMIN criada automaticamente na primeira execução
ADMIN_NAME=admin
ADMIN_EMAIL=admin@eletrolonghi.com
ADMIN_PASSWORD=admin@123

# Dados da loja - impressos no cabeçalho do recibo de pagamento
SHOP_NAME=Eletro Longhi
SHOP_DOCUMENT=
SHOP_ADDRESS=
SHOP_PHONE=
SHOP_EMAIL=
SHOP_WARRANTY_DAYS=90

# Mercado Pago - integração futura (maquininha via API Point). Deixe vazio até hospedar a aplicação.
MP_ACCESS_TOKEN=
MP_BASE_URL=https://api.mercadopago.com
MP_WEBHOOK_SECRET=

# Observabilidade (docker compose --profile observability) - Grafana em http://localhost:3001
# Em produção/staging troque a senha do admin e aponte o ROOT_URL para o endereço público (usado nos links das notificações)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
GRAFANA_ROOT_URL=http://localhost:3001
# Webhook do Discord para os alertas - só em produção/staging, um canal por ambiente (ex.: #alertas-prod, #alertas-staging).
# Em desenvolvimento deixe vazio/comentado: os alertas continuam visíveis no Grafana (Alerting), sem mandar mensagem.
# Preencher só para testar um alerta e, de preferência, com o webhook de um canal de teste.
#GRAFANA_DISCORD_WEBHOOK_URL=
